# MiniBatch 호스트별 값. 이 파일을 .env 로 복사해 경로를 이 기기에 맞춘다.
# 비밀 값은 넣지 않는다. 비밀 값은 MINIBATCH_SECRETS_DIR 폴더의 파일로만 넘긴다.
MINIBATCH_DATA_DIR=/Users/<사용자>/minibatch-data
MINIBATCH_SECRETS_DIR=/Users/<사용자>/.config/minibatch/secrets

# n8n 이미지 태그: GitHub 릴리스의 Latest(안정판). 2026-10-15 조회값
MINIBATCH_N8N_IMAGE_TAG=2.43.6
# 앱 이미지 태그: 커밋 해시 앞 7자리. 앱 이미지를 만들기 전에는 dev
MINIBATCH_APP_IMAGE_TAG=dev

# 렌더링 동시성. 운영 24GB 예산 기준 2. 개발 기기도 같은 값 (D14)
MINIBATCH_RENDER_CONCURRENCY=2
# 일정 실행 하루 최대 작업 수 (시범 운영 D27: 10)
MINIBATCH_DAILY_JOB_LIMIT=10
# 검토 대기가 이만큼 쌓이면 새 작업을 만들지 않는다 (D27: 15)
MINIBATCH_REVIEW_BACKLOG_LIMIT=15
# 텔레그램 승인을 받을 내 chat id (숫자, 비밀 값 아님). 비우면 텔레그램 승인이 꺼진다 (D28)
MINIBATCH_TELEGRAM_CHAT_ID=
